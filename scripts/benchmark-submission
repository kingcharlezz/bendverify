#!/usr/bin/env python3
"""Benchmark a VERIFIED submission (refuses otherwise).

  scripts/benchmark-submission submission.tar.zst [--reps N]
"""
import argparse
import json
import sys

from _common import banner
import bench
from bendverify import verify as V
from bendverify.competition import CompetitionError

ap = argparse.ArgumentParser()
ap.add_argument("archive")
ap.add_argument("--reps", type=int, default=None)
ap.add_argument("--json", action="store_true")
a = ap.parse_args()
try:
    from bendverify.competition import load
    reps = a.reps or load(self_check=False)["rules"]["benchmark"]["reps"]
    rep = bench.benchmark(a.archive, reps=reps)
except bench.Refuse as e:
    print()
    banner([("Benchmark", "BLOCKED"), ("Reason", str(e))])
    sys.exit(1)
except (CompetitionError, V.Reject) as e:
    print(f"benchmark refused to run: {e}")
    sys.exit(2)
if a.json:
    print(json.dumps(rep, indent=1))
print()
banner([("Candidate", rep["candidate_repo_hash"]), ("Score speedup", f"{rep['score_speedup']}x")])
