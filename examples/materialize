#!/usr/bin/env python3
"""Materialize an example candidate: the pinned reference Bend tree (git archive,
no .git) plus the example's overlay/ files, plus its proof sources.

  examples/materialize <example-dir> <out-dir>
"""
import json
import os
import shutil
import subprocess
import sys
import tarfile
import io

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
ex, out = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
commit = json.load(open(os.path.join(ROOT, "competition.json")))["rules"]["reference_commit"]
shutil.rmtree(out, ignore_errors=True)
os.makedirs(os.path.join(out, "bend"))
tar = subprocess.run(["git", "-C", os.path.join(ROOT, "reference", "bend"), "archive", commit],
                     capture_output=True, check=True).stdout
with tarfile.open(fileobj=io.BytesIO(tar)) as t:
    t.extractall(os.path.join(out, "bend"), filter="data")
ov = os.path.join(ex, "overlay")
if os.path.isdir(ov):
    shutil.copytree(ov, os.path.join(out, "bend"), dirs_exist_ok=True)
for extra in ("proof-src", "prove.json"):
    p = os.path.join(ex, extra)
    if os.path.isdir(p):
        shutil.copytree(p, os.path.join(out, extra))
    elif os.path.isfile(p):
        shutil.copy2(p, os.path.join(out, extra))
print(out)
